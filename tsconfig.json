// Cheap type gate over the JSDoc'd ESM sources: no emission, no runtime
// change.
{
  "compilerOptions": {
    "allowJs": true,
    "types": ["node"],
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "strict": true,
    // Phase 3 exit criterion: flip to true when src/ modules land with JSDoc
    // types; Phase 3 is not closed until noImplicitAny: true is green.
    "noImplicitAny": false
  },
  "include": ["lint.mjs", "server.mjs", "api/**/*.mjs", "scripts/**/*.mjs", "bench/**/*.mjs", "test/**/*.mjs"]
}
